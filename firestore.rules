rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 表のIDを知っている人だけが読み書きできる。表の一覧を取ることはできない。

    // 相性表
    match /boards/{board} {
      allow get: if board.size() >= 16;
      allow create, update: if board.size() >= 16
        && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 30;
      allow list, delete: if false;

      match /cells/{cell} {
        allow read, delete: if board.size() >= 16;
        allow create, update: if board.size() >= 16
          && request.resource.data.keys().hasOnly(['row', 'col', 'r', 'w', 'l', 'note'])
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 2000;
      }
    }

    // CRスコア管理表
    match /scoreboards/{board} {
      allow get: if board.size() >= 16;
      allow create, update: if board.size() >= 16
        && request.resource.data.keys().hasOnly(['classes', 'seasons', 'current']);
      allow list, delete: if false;

      // 旧形式（1枚だけのスコア表）。最初の環境へ移すときに読むだけ
      match /players/{player} {
        allow read: if board.size() >= 16;
        allow write: if false;
      }

      // チームメンバー名簿
      match /members/{member} {
        allow read, delete: if board.size() >= 16;
        allow create, update: if board.size() >= 16
          && request.resource.data.keys().hasOnly(['name', 'handle', 'order'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
      }

      // 内戦（運営用の一覧。中身は下の cups にある）
      match /tournaments/{tour} {
        allow read, delete: if board.size() >= 16;
        allow create, update: if board.size() >= 16
          && request.resource.data.keys().hasOnly(['name', 'created', 'pub'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
      }

      // 名簿メンバーのゲーム内ユーザーID（参加者ページでXYZメンバーかどうかの判定に使う）
      match /memberUids/{m} {
        allow read, delete: if board.size() >= 16;
        allow create, update: if board.size() >= 16
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid is string
          && request.resource.data.uid.size() <= 20;
      }

      // 出禁リスト（運営用URLを知っている人だけが読み書きできる）
      match /bans/{ban} {
        allow read, delete: if board.size() >= 16;
        allow create, update: if board.size() >= 16
          && request.resource.data.keys().hasOnly(['name', 'uid', 'handle', 'reason', 'at']);
      }

      // 実績（優勝・準優勝・決勝進出の記録）
      match /records/{rec} {
        allow read, delete: if board.size() >= 16;
        allow create, update: if board.size() >= 16
          && request.resource.data.keys().hasOnly(['name', 'events']);
      }

      // 所属チーム（名前の横のチームアイコン）
      match /teams/{t} {
        allow read, delete: if board.size() >= 16;
        allow create, update: if board.size() >= 16
          && request.resource.data.keys().hasOnly(['name', 'team', 'at'])
          && request.resource.data.team is string
          && request.resource.data.team.size() <= 8;
      }

      // 環境ごとのスコア表
      match /seasons/{season} {
        allow get: if board.size() >= 16;
        allow create, update: if board.size() >= 16
          && request.resource.data.keys().hasOnly(['classes']);
        allow list, delete: if false;

        match /players/{player} {
          allow read, delete: if board.size() >= 16;
          allow create, update: if board.size() >= 16
            && request.resource.data.keys().hasOnly(['name', 'handle', 'order', 'e', 'member'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 40;
        }
      }
    }

    // 参加者ページ（全大会共通のURL）。合言葉（key）を知っている人だけが入れる
    match /portals/{key} {
      allow get: if key.size() >= 20;
      allow create, update: if key.size() >= 20
        && request.resource.data.keys().hasOnly(['xyz', 'updated']);
      allow list, delete: if false;

      // 大会一覧（運営画面が書き込む）
      match /events/{ev} {
        allow read, delete: if key.size() >= 20;
        allow create, update: if key.size() >= 20
          && request.resource.data.keys().hasOnly(['name', 'kind', 'status', 'created', 'format', 'n', 'startAt']);
      }

      // 参加者のプロフィール：ログインした本人だけが読み書きできる
      match /users/{u} {
        allow get: if request.auth != null
          && request.auth.token.email == u + '@player.xyzcup.app';
        allow create, update: if request.auth != null
          && request.auth.token.email == u + '@player.xyzcup.app'
          && request.resource.data.keys().hasOnly(['name', 'handle', 'icon', 'hideTeam', 'at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && (request.resource.data.icon == null || (request.resource.data.icon is string && request.resource.data.icon.size() <= 40000));
        allow list, delete: if false;
      }

      // XYZメンバー申請：アカウントを作った本人が書き、運営画面が読んで承認・却下する
      match /claims/{u} {
        allow read, delete: if key.size() >= 20;
        allow create, update: if request.auth != null
          && request.auth.token.email == u + '@player.xyzcup.app'
          && request.resource.data.keys().hasOnly(['name', 'handle', 'at'])
          && request.resource.data.handle is string
          && request.resource.data.handle.size() <= 30;
      }

      // 戦績：運営画面が書き込み、本人だけが読める
      match /stats/{u}/events/{ev} {
        allow read: if request.auth != null && request.auth.token.email == u + '@player.xyzcup.app';
        allow create, update: if key.size() >= 20
          && request.resource.data.keys().hasOnly(['name', 'kind', 'created', 'status', 'me', 'n', 'rank', 'place', 'w', 'l', 'matches']);
        allow delete: if key.size() >= 20;
      }
    }

    // 内戦の大会データ。参加者用URLの合言葉（cup）を知っている人だけが読み書きできる
    match /cups/{cup} {
      allow get, delete: if cup.size() >= 20;
      allow create, update: if cup.size() >= 20
        && request.resource.data.keys().hasOnly(['name', 'created', 'status', 'swissRounds', 'topCut', 'ban', 'format', 'formatSwiss', 'formatTop', 'kind', 'lobby', 'players', 'rounds', 'bracket', 'roster', 'banHashes', 'badges', 'teams', 'pros', 'xyz', 'startAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow list: if false;

      match /entries/{entry} {
        allow read, delete: if cup.size() >= 20;
        allow create, update: if cup.size() >= 20
          && request.resource.data.keys().hasOnly(['member', 'name', 'handle', 'uid', 'icon', 'decks', 'order', 'hideTeam', 'checkedIn'])
          && (!('icon' in request.resource.data) || request.resource.data.icon == null || (request.resource.data.icon is string && request.resource.data.icon.size() <= 40000))
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
      }

      match /chat/{msg} {
        allow read: if cup.size() >= 20;
        allow create: if cup.size() >= 20
          && request.resource.data.keys().hasOnly(['m', 'from', 'text', 'at', 'img', 'call', 'resolve', 'ref'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 120
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 400000));
        allow delete: if cup.size() >= 20;
        allow update: if false;
      }

      match /matches/{mid} {
        allow read, delete: if cup.size() >= 20;
        allow create, update: if cup.size() >= 20
          && request.resource.data.keys().hasOnly(['winner', 'score', 'da', 'db', 'ba', 'bb', 'at', 'room', 'roomBy', 'roomAt', 'entered', 'forfeit', 'manual', 'games']);
      }
    }
  }
}
